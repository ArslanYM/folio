# OpenRouter API credentials & model selection
# Browse models at https://openrouter.ai/models (filter by "image input" for vision)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_TEXT=          # used for URL mode (e.g. nvidia/nemotron-3.5-lightning:free or openrouter/free)
OPENROUTER_MODEL_VISION=        # used for screenshot mode (e.g. openrouter/free)
OPENROUTER_FALLBACK_MODEL=      # optional; tried if primary fails (e.g. openrouter/free)

# App metadata sent to OpenRouter (HTTP-Referer; X-Title is "Swatchbook")
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags & limits
ENABLE_SCREENSHOT=false
RATE_LIMIT_PER_HOUR=20
